#!/bin/sh
# every keybinding hyprland has, searchable in the launcher. picking one
# runs it. super + k. from examples/omarchy-lite.
binds=$(hyprctl binds -j | jq -r '
  .[] | select(.key != "") |
  [ (if (.modmask / 64 | floor) % 2 == 1 then "SUPER" else empty end),
    (if (.modmask / 4 | floor) % 2 == 1 then "CTRL" else empty end),
    (if (.modmask / 8 | floor) % 2 == 1 then "ALT" else empty end),
    (if .modmask % 2 == 1 then "SHIFT" else empty end),
    .key ] as $keys |
  "\($keys | join(" + "))\t\(if .description != "" then .description else "\(.dispatcher) \(.arg)" end)\t\(.dispatcher)\t\(.arg)"')
line=$(printf '%s\n' "$binds" | cut -f1,2 | sed 's/\t/  →  /' |
  fuzzel --dmenu --prompt "keys  " --width 90 --index) || exit 0
printf '%s\n' "$binds" | sed -n "$((line + 1))p" | {
  IFS="$(printf '\t')" read -r _ _ dispatcher arg
  hyprctl dispatch "$dispatcher" "$arg" >/dev/null
}
