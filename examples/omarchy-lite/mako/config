# notifications, in the top right, in tokyo night. super + comma dismisses
# one. from examples/omarchy-lite.
anchor=top-right
outer-margin=20
padding=10,15
width=420
border-size=2
border-radius=0
font=JetBrainsMono Nerd Font 11
icons=1
max-icon-size=32
default-timeout=5000
background-color=#1a1b26
text-color=#a9b1d6
border-color=#7aa2f7
progress-color=over #414868

[urgency=critical]
border-color=#f7768e
default-timeout=0

# super + ctrl + comma
[mode=do-not-disturb]
invisible=1
