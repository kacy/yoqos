{
  "version": "4.4",
  "script": "guided",
  "archinstall-language": "English",
  "bootloader_config": { "bootloader": "Grub", "uki": false, "removable": false },
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/vdb",
        "wipe": true,
        "partitions": [
          {
            "obj_id": "b0a6f0de-7a52-4c1e-9d8f-1f0a1d2b3c01",
            "status": "create",
            "type": "primary",
            "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 1 },
            "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "GiB", "value": 1 },
            "fs_type": "fat32",
            "mountpoint": "/boot",
            "mount_options": [],
            "flags": ["boot", "esp"],
            "dev_path": null,
            "btrfs": []
          },
          {
            "obj_id": "b0a6f0de-7a52-4c1e-9d8f-1f0a1d2b3c02",
            "status": "create",
            "type": "primary",
            "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 1025 },
            "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "MiB", "value": 15350 },
            "fs_type": "btrfs",
            "mountpoint": null,
            "mount_options": ["compress=zstd"],
            "flags": [],
            "dev_path": null,
            "btrfs": [{ "name": "@", "mountpoint": "/" }, { "name": "@home", "mountpoint": "/home" }, { "name": "@log", "mountpoint": "/var/log" }, { "name": "@pkg", "mountpoint": "/var/cache/pacman/pkg" }]
          }
        ]
      }
    ]
  },
  "hostname": "yoq-test",
  "kernels": ["linux"],
  "locale_config": { "kb_layout": "us", "sys_enc": "UTF-8", "sys_lang": "en_US" },
  "mirror_config": {
    "custom_servers": [{ "url": "https://geo.mirror.pkgbuild.com/$repo/os/$arch" }],
    "mirror_regions": {},
    "optional_repositories": [],
    "custom_repositories": []
  },
  "network_config": { "type": "nm" },
  "ntp": true,
  "packages": ["openssh"],
  "services": ["sshd"],
  "swap": { "enabled": true, "algorithm": "zstd" },
  "timezone": "UTC",
  "custom_commands": [
    "install -d -m 700 /root/.ssh && echo 'KEY' > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys",
    "sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"console=tty0 console=ttyS0,115200 /' /etc/default/grub && grub-mkconfig -o /boot/grub/grub.cfg"
  ]
}
