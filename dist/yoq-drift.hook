# records package changes made with pacman directly, so `os status` can say
# what changed outside os. the os package installs this to
# /usr/share/libalpm/hooks.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Recording package changes for os status...
When = PostTransaction
Exec = /usr/bin/os record-pacman
NeedsTargets
